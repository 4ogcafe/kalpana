DirectoryIndex index.html index.php

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Redirect www to non-www (HTTPS)
  RewriteCond %{HTTP_HOST} ^www\.kalpnacurry\.com$ [NC]
  RewriteRule ^(.*)$ https://kalpnacurry.com/$1 [R=301,L]

  # 1. Block access to hidden files, config files, env, and source code
  RewriteRule "(^|/)\.(?!well-known)" - [F,L]
  RewriteRule "(^|/)(kalpana-config\.php|\.env|\.git|composer\.(json|lock)|package(-lock)?\.json|tsconfig.*\.json)$" - [F,L]

  # 2. Serve real files and directories as-is
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # 3. Route missing /uploads/* requests to PHP API gateway (persistent backup or 404, never index.html)
  RewriteRule ^uploads(/.*)?$ api/index.php [QSA,L]

  # 4. Route API requests to PHP API gateway
  RewriteRule ^api(/.*)?$ api/index.php [QSA,L]

  # 5. Frontend SPA fallback
  RewriteRule ^ index.html [L]
</IfModule>

# Caching Configuration
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
</IfModule>

# Security Headers & Cache-Control
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set X-XSS-Protection "1; mode=block"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"

  # Immutable cache for version-hashed assets
  <FilesMatch "\.(js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # HTML & Service Worker must revalidate to avoid stale deployments
  <FilesMatch "(index\.html|sw\.js)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>
</IfModule>
