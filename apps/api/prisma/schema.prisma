generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  STAFF
  // Kitchen display only (/kitchen): sees and moves orders, nothing else.
  KITCHEN
}

enum MenuType {
  LUNCH
  TAKEOUT
  GRAND
}

enum Placement {
  HOME
  CONTACT
}

enum OrderStatus {
  NEW
  CONFIRMED
  READY
  COMPLETED
  CANCELLED
}

enum EnquiryType {
  GENERAL
  RESERVATION
  CATERING
  FEEDBACK
}

model User {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  email        String   @unique
  passwordHash String
  name         String
  role         Role     @default(STAFF)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Menu {
  id           String     @id @default(auto()) @map("_id") @db.ObjectId
  type         MenuType   @unique
  nameEn       String
  nameJa       String?
  descriptionEn String?
  descriptionJa String?
  servingHours Json?      // [{ day: 1, open: "11:00", close: "15:00" }]
  notesEn      String?    // e.g. pickup info for takeout
  notesJa      String?
  pdfUrl       String?
  isActive     Boolean    @default(true)
  categoryIDs  String[]   @db.ObjectId
  categories   Category[] @relation(fields: [categoryIDs], references: [id])
}

model Category {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  // Table QR menu: true = show, false = hide, null/unset = automatic.
  dineIn    Boolean?
  nameEn    String
  nameJa    String?
  sortOrder Int      @default(0)
  parentId  String?  @db.ObjectId
  parent    Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  subCategories Category[] @relation("CategoryHierarchy")
  menuIDs   String[] @db.ObjectId
  menus     Menu[]   @relation(fields: [menuIDs], references: [id])
  items     MenuItem[]
}

model MenuItem {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  categoryId    String   @db.ObjectId
  category      Category @relation(fields: [categoryId], references: [id])
  menuTypes     MenuType[]
  nameEn        String
  nameJa        String?
  descriptionEn String?
  descriptionJa String?
  price         Int
  variants      ItemVariant[]
  imageUrl      String?
  rating        Float?   // admin-entered 0–5; null when not set
  spiceLevel    Int      @default(0)
  isVegetarian  Boolean  @default(false)
  isVegan       Boolean  @default(false)
  isHalal       Boolean  @default(false)
  isGlutenFree  Boolean  @default(false)
  allergens     String[]
  isRecommended Boolean  @default(false)
  isSoldOut     Boolean  @default(false)
  isActive      Boolean  @default(true)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  @@index([categoryId, sortOrder])
}

model ItemVariant {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  itemId    String   @db.ObjectId
  item      MenuItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  labelEn   String
  labelJa   String?
  price     Int
  sortOrder Int      @default(0)
}

model CarouselSlide {
  id         String    @id @default(auto()) @map("_id") @db.ObjectId
  placement  Placement
  imageUrl   String
  altEn      String
  altJa      String?
  titleEn    String?
  titleJa    String?
  subtitleEn String?
  subtitleJa String?
  ctaLabelEn String?
  ctaLabelJa String?
  ctaLink    String?
  sortOrder  Int       @default(0)
  startAt    DateTime?
  endAt      DateTime?
  isActive   Boolean   @default(true)
}

model Settings {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  name         String
  addressEn    String
  addressJa    String?
  lat          Float
  lng          Float
  phone        String
  email        String
  timezone     String   @default("Asia/Tokyo")
  currency     String   @default("JPY")
  weeklyHours  Json
  holidays     Json
  socials      Json
  googlePlaceId String?
  mapUrl       String?
  aboutEn      String?
  aboutJa      String?
  aboutHeroImage    String?
  aboutStoryJa      String?
  aboutStoryLabelJa String?
  aboutStoryTitleJa String?
  aboutSpiceLabelJa String?
  aboutSpiceTitleJa String?
  aboutSpiceDescJa  String?
  aboutSpiceImage   String?
  aboutChefLabelJa  String?
  aboutChefTitleJa  String?
  aboutChefDescJa   String?
  aboutChefImage    String?
  contactHeroImage  String?
  menuLunchHeroImage  String?
  menuTakeoutHeroImage String?
  menuGrandHeroImage  String?
  pickupEnabled     Boolean  @default(false)
  pickupHours       String?  // "11:30-14:30, 17:00-21:30"
  pickupClosedDays  Int[]    // 0 = Sunday … 6 = Saturday
  pickupClosedDates String[] // YYYY-MM-DD
  pickupLeadMinutes Int?
  pickupNoteJa      String?
  // The website address printed in table QR codes ('' = the admin's own address).
  publicSiteUrl       String?
  // Footer: logo, brand name, description, links (JSON [{label, url}]), copyright, what to show.
  footerLogo        String?
  footerBrand       String?
  footerTaglineJa   String?
  footerCopyright   String?
  footerLinks       Json?
  footerShowHours   Boolean?
  footerShowSocials Boolean?
  // Google reviews: the lowest star rating to show (the Place ID is googlePlaceId).
  googleReviewsMinRating Int?
  // Shown until Google is connected: total Google review count and reviews copied from the listing.
  storeReviewCount       Int?
  featuredReviews        Json?
  // Dine-in ordering from the table QR codes.
  diningEnabled       Boolean?
  diningSelfOpen      Boolean?
  diningTargetMinutes Int?
  // Set from the kitchen display when it is too busy: no new online orders until then.
  orderingPausedUntil DateTime?
  pointsEnabled     Boolean? // missing = on
  pointsPer100Yen   Int?
  pointValueYen     Int?
  signupBonusPoints Int?
  taxRatePercent    Int?     // consumption tax on orders; missing = 8 (reduced rate for takeout)
  updatedAt    DateTime @updatedAt
}

model ContactMessage {
  id        String      @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  email     String
  phone     String?
  type      EnquiryType @default(GENERAL)
  date      DateTime?
  guests    Int?
  message   String
  isRead    Boolean     @default(false)
  ip        String?
  createdAt DateTime    @default(now())
}

type OrderLine {
  itemId    String @db.ObjectId
  nameEn    String
  nameJa    String?
  unitPrice Int
  quantity  Int
  lineTotal Int
  // Ticked off on the kitchen display.
  doneAt    DateTime?
}

// Pay-at-pickup orders. `number` restarts each day (dateKey, restaurant timezone);
// `token` is the unguessable key for the customer's status page.
model PickupOrder {
  id           String      @id @default(auto()) @map("_id") @db.ObjectId
  number       Int
  dateKey      String
  token        String      @unique
  status       OrderStatus @default(NEW)
  customerName String
  phone        String
  email        String?
  note         String?
  pickupAt     DateTime
  items        OrderLine[]
  customerId   String?     @db.ObjectId
  subtotal     Int?
  offer        AppliedOffer?
  pointsUsed   Int         @default(0)
  pointsDiscount Int       @default(0)
  total        Int         // after discounts, tax excluded; points are earned on this
  taxRate      Int?
  tax          Int?
  grandTotal   Int?        // what the customer pays at pickup, tax included
  pointsEarned Int         @default(0)
  // Dine-in orders: the table and the visit (one bill per visit). Pickup/delivery orders leave these empty.
  tableId      String?     @db.ObjectId
  tableNumber  String?
  sessionId    String?     @db.ObjectId
  // When each step happened, for the kitchen's timers and prep-time stats.
  confirmedAt  DateTime?
  readyAt      DateTime?
  completedAt  DateTime?
  cancelledAt  DateTime?
  ip           String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([status, pickupAt])
  @@index([customerId, createdAt])
}

type AppliedOffer {
  id       String @db.ObjectId
  titleJa  String
  discount Int
}

enum DiscountType {
  PERCENT
  AMOUNT
}

enum PointType {
  EARN
  REDEEM
  REFUND
  BONUS
  ADJUST
}

// Registered customers. Kept apart from staff `User`s: separate collection, cookie and token audience.
model Customer {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  email        String   @unique
  passwordHash String
  name         String
  nameKana     String?
  phone        String?
  birthDate    String?  // YYYY-MM-DD; a calendar date, so no timezone
  address      CustomerAddress?
  preferences  CustomerPreferences?
  newsletterOptIn   Boolean   @default(false)
  newsletterOptInAt DateTime? // when consent was given
  points       Int      @default(0)
  isActive     Boolean  @default(true)
  deletedAt    DateTime? // set when the member closes the account (personal data erased)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

type CustomerAddress {
  postalCode String?
  prefecture String?
  city       String?
  line1      String?
  building   String?
}

type CustomerPreferences {
  allergens      String[]
  otherAllergies String?
  diets          String[] // VEGETARIAN | VEGAN | HALAL | GLUTEN_FREE
  spiceLevel     Int?     // 0–5
  note           String?
}

// Every change to a customer's points, with the balance afterwards.
model PointTransaction {
  id           String    @id @default(auto()) @map("_id") @db.ObjectId
  customerId   String    @db.ObjectId
  type         PointType
  points       Int
  balanceAfter Int
  orderId      String?   @db.ObjectId
  orderNumber  Int?
  note         String?
  userId       String?   @db.ObjectId // staff member, for manual adjustments
  createdAt    DateTime  @default(now())

  @@index([customerId, createdAt])
}

model Offer {
  id              String       @id @default(auto()) @map("_id") @db.ObjectId
  titleJa         String
  descriptionJa   String?
  imageUrl        String?
  discountType    DiscountType
  discountValue   Int          // percent, or yen
  minSubtotal     Int          @default(0)
  startsAt        DateTime?
  endsAt          DateTime?
  oncePerCustomer Boolean      @default(false)
  isActive        Boolean      @default(true)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
}

model OrderCounter {
  id  String @id @map("_id")
  seq Int
}

model AuditLog {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  action    String
  entity    String
  entityId  String
  diff      Json?
  createdAt DateTime @default(now())
}

// A table in the restaurant. Its QR code links to /t/<qrToken>; a new token makes old printouts stop working.
model DiningTable {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  number    String   @unique
  name      String?
  seats     Int      @default(4)
  area      String?
  qrToken   String   @unique
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum TableSessionStatus {
  OPEN
  BILL_REQUESTED
  CLOSED
}

type TableCall {
  id         String
  type       String    // STAFF | WATER | BILL
  createdAt  DateTime
  resolvedAt DateTime?
}

// One visit to a table: every order placed while it is open goes on one bill, paid at the register.
model TableSession {
  id            String             @id @default(auto()) @map("_id") @db.ObjectId
  tableId       String             @db.ObjectId
  tableNumber   String
  status        TableSessionStatus @default(OPEN)
  guests        Int?
  openedAt      DateTime           @default(now())
  openedBy      String             // GUEST | STAFF
  calls         TableCall[]
  customerIds   String[]           @db.ObjectId
  lastOrderAt   DateTime?
  closedAt      DateTime?
  paymentMethod String?            // CASH | CARD | QR | OTHER
  subtotal      Int?
  tax           Int?
  total         Int?

  @@index([tableId, status])
}
