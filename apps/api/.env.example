DATABASE_URL="mysql://root:password@localhost:3306/kalpanarestro"
# Required in production: at least 32 random characters, e.g. `openssl rand -hex 32`
JWT_SECRET=""
PORT=4000
# Comma-separated origins allowed to call the API with cookies
CORS_ORIGINS="http://localhost:5173"
# Set to the number of proxies in front of the API (e.g. 1) so rate limits see the real client IP
TRUST_PROXY=false
# New member accounts allowed per IP per hour
REGISTER_MAX_PER_HOUR=10
# Orders allowed per IP per hour
ORDER_MAX_PER_HOUR=10

# Google reviews on the home page (optional). Create a key in Google Cloud with "Places API (New)"
# enabled, restricted to that API. Kept on the server only; never sent to browsers.
GOOGLE_PLACES_API_KEY=

# "Your food is ready" push notifications (optional). Without these a key pair is created once and kept
# in the database. To set your own: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:info@your-restaurant.jp

# Square payments (optional). Get credentials at developer.squareup.com.
# Set SQUARE_ENVIRONMENT=sandbox for testing, production for live payments.
# SQUARE_APPLICATION_ID and SQUARE_ACCESS_TOKEN are on the Credentials page.
# SQUARE_LOCATION_ID is shown on the Locations page in your Square dashboard.
# SQUARE_WEBHOOK_URL is the full public URL of the /api/v1/square/webhook endpoint.
# SQUARE_WEBHOOK_SIGNATURE_KEY is shown after creating a webhook subscription.
SQUARE_ACCESS_TOKEN=EAAAl-JWak2JpsIHDRmu3Y6XUDJPWqbOC5sPTdl5Wm2_tuv3xfBk6iHobjakjcDh
SQUARE_APPLICATION_ID=sandbox-sq0idb-R8DCmoFS2OoXB8dP6_Mv9g
SQUARE_LOCATION_ID=LAZXNVT20HB5S
SQUARE_ENVIRONMENT=sandbox-sq0idb-R8DCmoFS2OoXB8dP6_Mv9g
SQUARE_WEBHOOK_URL=https://your-domain.com/api/v1/square/webhook
SQUARE_WEBHOOK_SIGNATURE_KEY=
