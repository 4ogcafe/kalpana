# Hostinger Git deploys this whole repository into the web root.
# The deployable site lives in ./public_html, so route every request there.
# Repo files (README.md, docs/, apps/, ...) are never served directly.

DirectoryIndex index.html index.php
Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Block access to hidden files and repo source code
  RewriteRule "(^|/)\.(?!well-known)" - [F,L]
  RewriteRule "(^|/)(kalpana-config\.php|\.env|\.git|composer\.(json|lock)|package(-lock)?\.json|tsconfig.*\.json)$" - [F,L]
  RewriteRule "^(apps|packages|docs|\.agents|\.vscode)(/.*)?$" - [F,L]

  # 2. Stop immediately on internal subrequests to prevent any rewrite loop (LiteSpeed 503 fix)
  RewriteCond %{ENV:REDIRECT_STATUS} !^$
  RewriteRule ^ - [L]

  # 3. Route API requests directly to PHP API gateway
  RewriteRule ^api(/.*)?$ public_html/api/index.php [QSA,L]

  # 4. If file or directory exists inside public_html/, serve it
  RewriteCond %{DOCUMENT_ROOT}/public_html/$1 -f [OR]
  RewriteCond %{DOCUMENT_ROOT}/public_html/$1 -d
  RewriteRule ^(.*)$ public_html/$1 [L]

  # 5. Frontend SPA fallback
  RewriteRule ^ public_html/index.html [L]
</IfModule>
